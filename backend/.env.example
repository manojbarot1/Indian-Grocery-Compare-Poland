# Postgres (docker compose sets this for the api service automatically)
DATABASE_URL=postgresql+psycopg://desicena:desicena@localhost:55432/desicena

# Market this instance prices for
MARKET_COUNTRY=PL
DISPLAY_CURRENCY=PLN

# Be polite to the shops we ingest from
REQUEST_DELAY_SECONDS=1.0
HTTP_USER_AGENT=DesiPriceBot/0.1 (+https://desiprice.pl/bot; price comparison)

# Raising this loses true merges; lowering it starts merging product variants.
MATCH_THRESHOLD=0.72
